@startuml sequence_diagram
autonumber
skinparam monochrome false
skinparam roundcorner 8
skinparam shadowing true
skinparam defaultFontName "Courier"
skinparam participantPadding 10
skinparam boxPadding 10

actor "Operator CLI" as User
box "User Space Application" #E8F5E9
    participant "main()" as Main
    participant "VaultManager" as VM
    participant "KeyDerivation" as KD
    participant "FileLock" as FL
    participant "AtomicFileWriter" as AFW
    participant "UniqueFd" as UFD
end box

box "Kernel Boundary & Device Driver" #FFF3E0
    participant "VFS / DevFS" as VFS
    participant "/dev/kvault" as KMOD
    participant "Linux Crypto API" as CRYPTO
end box

box "Storage Hardware / VFS" #F0F4F8
    participant "NVMe / Ext4 / XFS" as DISK
end box

User -> Main: kvault encrypt --in sensitive.pdf --vault /vault --key "Passphrase"
activate Main

Main -> VM: encryptFile("sensitive.pdf", "Passphrase")
activate VM

VM -> FL: FileLock("/vault/sensitive.pdf.lock", LockType::Exclusive)
activate FL
FL -> VFS: fcntl(fd, F_SETLK, &flock{F_WRLCK})
VFS --> FL: 0 (Lock Acquired)
FL --> VM: Lock Handle

VM -> KD: generateSalt(salt[16])
KD --> VM: OK (Cryptographic Salt)

VM -> KD: deriveKeyPbkdf2("Passphrase", salt, key[32], 100000)
activate KD
KD --> VM: Derived 256-bit Key
deactivate KD

VM -> KD: secureZero("Passphrase")
note right: User-space raw password purged immediately

VM -> VFS: open("/dev/kvault", O_RDWR)
activate VFS
VFS -> KMOD: kvault_open()
activate KMOD
KMOD -> KMOD: atomic_cmpxchg(&dev_busy, 0, 1)
KMOD --> VFS: fd
VFS --> VM: UniqueFd(dev_fd)
deactivate KMOD

VM -> VFS: ioctl(dev_fd, KVAULT_IOCTL_SET_KEY, &key_param)
VFS -> KMOD: kvault_ioctl(KVAULT_IOCTL_SET_KEY)
activate KMOD
KMOD -> KMOD: copy_from_user(session_key, arg)
KMOD -> CRYPTO: crypto_skcipher_setkey(tfm, session_key, 32)
CRYPTO --> KMOD: 0 (Key Configured)
KMOD --> VFS: 0 (Success)
VFS --> VM: 0 (Success)
deactivate KMOD

VM -> KD: secureZero(key[32])
note right: User-space derived key purged immediately

VM -> AFW: AtomicFileWriter("/vault/records/sensitive.pdf.enc")
activate AFW
AFW -> VFS: open(".tmp.<pid>.<uuid>", O_CREAT|O_WRONLY, 0600)
VFS --> AFW: UniqueFd(tmp_fd)

VM -> AFW: write(VaultHeader { Magic, Salt, IV, PayloadSize })

loop Read 64 KiB chunks from input file
    VM -> VFS: write(dev_fd, plaintext_chunk, 65536)
    VFS -> KMOD: kvault_write(plaintext_chunk)
    activate KMOD
    KMOD -> CRYPTO: sg_init_one(&sg), crypto_skcipher_encrypt(req)
    CRYPTO --> KMOD: Encrypted in-place in kernel buffer
    KMOD --> VFS: bytes_written
    deactivate KMOD

    VM -> VFS: read(dev_fd, ciphertext_chunk, 65536)
    VFS -> KMOD: kvault_read(ciphertext_chunk)
    activate KMOD
    KMOD -> KMOD: copy_to_user(user_buf, kernel_buf)
    KMOD --> VFS: bytes_read
    deactivate KMOD

    VM -> AFW: write(ciphertext_chunk)
end

VM -> AFW: commit()
AFW -> VFS: fsync(tmp_fd)
VFS -> DISK: Barrier / Flush Dirty Pages to Disk Blocks
DISK --> VFS: Synced
AFW -> VFS: close(tmp_fd)

AFW -> VFS: renameat2(AT_FDCWD, tmp_path, AT_FDCWD, final_path, RENAME_NOREPLACE)
VFS -> DISK: Atomic Directory Inode Swap
DISK --> VFS: 0 (Success)
AFW --> VM: Commit Success
deactivate AFW

VM -> VFS: ioctl(dev_fd, KVAULT_IOCTL_FLUSH_KEY)
VFS -> KMOD: kvault_ioctl(KVAULT_IOCTL_FLUSH_KEY)
activate KMOD
KMOD -> KMOD: memzero_explicit(session_key, 32)
KMOD --> VFS: 0
VFS --> VM: 0
deactivate KMOD

VM -> UFD: reset() -> close(dev_fd)
VFS -> KMOD: kvault_release()
activate KMOD
KMOD -> KMOD: atomic_set(&dev_busy, 0)
deactivate KMOD

VM -> FL: ~FileLock() -> fcntl(fd, F_SETLK, &flock{F_UNLCK})
deactivate FL

VM --> Main: Success
deactivate VM

Main --> User: File encrypted and stored atomically into vault.
deactivate Main
@enduml
