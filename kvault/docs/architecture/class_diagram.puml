@startuml class_diagram
skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam roundcorner 8
skinparam shadowing true
skinparam defaultFontName "Courier"

package "Linux Kernel Space" #F0F4F8 {
    class kvault_module << (K,#FFAAAA) Kernel Driver >> {
        - major_number: int
        - dev_class: struct class*
        - device: struct device*
        - cdev: struct cdev
        - tfm: struct crypto_skcipher*
        - device_busy: atomic_t
        - cipher_mutex: struct mutex
        - session_key[32]: u8
        - session_iv[16]: u8
        - is_key_set: bool
        - cipher_mode: int
        + kvault_open(inode*, file*): int
        + kvault_release(inode*, file*): int
        + kvault_read(file*, char*, size_t, loff_t*): ssize_t
        + kvault_write(file*, const char*, size_t, loff_t*): ssize_t
        + kvault_ioctl(file*, unsigned int, unsigned long): long
        - init_skcipher(): int
        - cleanup_skcipher(): void
        - do_crypto_transform(in_buf, out_buf, len, encrypt): int
    }
}

package "POSIX Wrappers & Core Primitives" #E8F5E9 {
    class UniqueFd {
        - m_fd: int
        + UniqueFd() noexcept
        + explicit UniqueFd(int fd) noexcept
        + ~UniqueFd() noexcept
        + UniqueFd(const UniqueFd&) = delete
        + operator=(const UniqueFd&) = delete
        + UniqueFd(UniqueFd&& other) noexcept
        + operator=(UniqueFd&& other) noexcept: UniqueFd&
        + get() const noexcept: int
        + release() noexcept: int
        + reset(int new_fd = -1) noexcept: void
        + valid() const noexcept: bool
        + explicit operator bool() const noexcept: bool
    }

    class FileLock {
        public enum class LockType { Shared, Exclusive }
        public enum class LockMode { Blocking, NonBlocking }
        - m_targetFd: int
        - m_locked: bool
        - m_type: LockType
        + FileLock(int fd, LockType type, LockMode mode)
        + ~FileLock() noexcept
        + FileLock(const FileLock&) = delete
        + operator=(const FileLock&) = delete
        + FileLock(FileLock&& other) noexcept
        + operator=(FileLock&& other) noexcept: FileLock&
        + lock(LockType type, LockMode mode): bool
        + unlock() noexcept: bool
        + isLocked() const noexcept: bool
        + static testLock(int fd, LockType type): std::optional<pid_t>
    }

    class AtomicFileWriter {
        - m_finalPath: std::filesystem::path
        - m_tempPath: std::filesystem::path
        - m_tempFd: UniqueFd
        - m_committed: bool
        + explicit AtomicFileWriter(const std::filesystem::path& destinationPath)
        + ~AtomicFileWriter() noexcept
        + AtomicFileWriter(const AtomicFileWriter&) = delete
        + operator=(const AtomicFileWriter&) = delete
        + AtomicFileWriter(AtomicFileWriter&&) noexcept
        + operator=(AtomicFileWriter&&) noexcept: AtomicFileWriter&
        + write(std::span<const uint8_t> buffer): bool
        + commit(): bool
        + abort() noexcept: void
        + getTempPath() const noexcept: const std::filesystem::path&
        - syncFileAndDirectory(): bool
    }
}

package "Cryptographic & Security Infrastructure" #FFF3E0 {
    class KeyDerivation {
        + static constexpr size_t KEY_SIZE = 32
        + static constexpr size_t SALT_SIZE = 16
        + static constexpr uint32_t DEFAULT_ITERATIONS = 100000
        + static deriveKeyPbkdf2(std::string_view passphrase, std::span<const uint8_t> salt, std::span<uint8_t, 32> outKey, uint32_t iterations): bool
        + static generateSalt(std::span<uint8_t, 16> outSalt): bool
        + static computeHmacSha256(std::span<const uint8_t> key, std::span<const uint8_t> data, std::span<uint8_t, 32> outMac): bool
        + static secureZero(void* ptr, size_t length) noexcept: void
    }

    class Logger {
        public enum class Level { Debug, Info, Warn, Error, Kernel }
        - static s_mutex: std::mutex
        - static s_minLevel: Level
        + static setLevel(Level level): void
        + static log(Level level, std::string_view msg): void
        + static debug(std::string_view msg): void
        + static info(std::string_view msg): void
        + static warn(std::string_view msg): void
        + static error(std::string_view msg): void
        + static kernel(std::string_view msg): void
    }
}

package "Application & Orchestration Layer" #E1F5FE {
    struct VaultHeader {
        + magic: uint32_t
        + version: uint32_t
        + salt: uint8_t[16]
        + iv: uint8_t[16]
        + originalSize: uint64_t
        + payloadSize: uint64_t
        + hmac[32]: uint8_t
    }

    class VaultManager {
        - m_vaultDir: std::filesystem::path
        - m_deviceFd: UniqueFd
        - m_useKernelAcceleration: bool
        + explicit VaultManager(std::filesystem::path vaultPath)
        + ~VaultManager() noexcept
        + initializeVault(): bool
        + encryptFile(const std::filesystem::path& srcFile, std::string_view passphrase): bool
        + decryptFile(const std::string& filename, const std::filesystem::path& destFile, std::string_view passphrase): bool
        + inspectStatus(): std::string
        - acquireLock(const std::string& filename, FileLock::LockType type): std::unique_ptr<FileLock>
        - initKernelDevice(): bool
        - configureKernelKey(std::span<const uint8_t, 32> key): bool
        - flushKernelKey(): void
        - transformChunk(std::span<const uint8_t> input, std::vector<uint8_t>& output, bool encrypt): bool
    }
}

VaultManager o-- UniqueFd : owns m_deviceFd
VaultManager ..> AtomicFileWriter : creates for atomic persistence
VaultManager ..> FileLock : creates for fcntl synchronization
VaultManager ..> KeyDerivation : invokes for key hashing & zeroing
VaultManager ..> Logger : reports status
AtomicFileWriter *-- UniqueFd : owns m_tempFd
VaultManager ..> kvault_module : interacts via ioctl & read/write

@enduml
