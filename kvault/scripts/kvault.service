[Unit]
Description=kvault Kernel Hardware Acceleration Daemon & Device Node Manager
Documentation=https://github.com/kvault/kvault
DefaultDependencies=no
After=systemd-modules-load.service
Before=local-fs.target systemd-udevd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/load_driver.sh
ExecStop=/usr/local/bin/unload_driver.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=basic.target
